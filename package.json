{
  "name": "nocodile",
  "private": true,
  "description": "Browser-only gesture training and Naruto-inspired shadow-clone effect.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-runtime.mjs",
    "dev": "bun run assets && vite --host 127.0.0.1",
    "build": "bun run assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src tests *.ts scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.12.0",
    "@fontsource/source-sans-pro": "5.3.0",
    "@mediapipe/holistic": "0.5.1675471629",
    "@mediapipe/selfie_segmentation": "0.1.1675465747",
    "@tensorflow/tfjs": "4.22.0",
    "idb": "8.0.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "packageManager": "bun@1.4.2"
}
